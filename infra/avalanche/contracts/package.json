    "@testing-library/user-event": "^14.6.1",
    "@vitest/ui": "^4.1.7",
    "hardhat": "^2.19.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
